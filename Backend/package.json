{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "bunx prisma generate && bun --watch src/app.ts",
    "start": "bunx prisma generate && bun src/app.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "bun scripts/init-db.ts && bunx prisma db push && bun scripts/ensure-vector-index.ts",
    "reindex": "bun scripts/reindex.ts",
    "test": "bun test tests/extraction tests/chunking tests/embedding tests/prompt tests/chat",
    "test:integration": "RUN_INTEGRATION_TESTS=1 bun test tests/database",
    "test:retrieval": "RUN_LIVE_RETRIEVAL_TESTS=1 bun test tests/retrieval",
    "test:llm": "RUN_LIVE_LLM_TESTS=1 bun test tests/llm",
    "test:e2e": "RUN_E2E_TESTS=1 bun test tests/e2e",
    "test:eval": "bun tests/eval/run-eval.ts"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@google/generative-ai": "^0.24.1",
    "@langfuse/core": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-jaeger": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/jest": "^30.0.0",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "fastify": "^5.10.0",
    "fastify-metrics": "^13.2.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.11.1",
    "mammoth": "^1.12.0",
    "openai": "^7.1.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  }
}